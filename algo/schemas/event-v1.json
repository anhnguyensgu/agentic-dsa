{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.algolearn/schemas/event-v1.json",
  "title": "Algorithm Learning event",
  "type": "object",
  "required": ["schema_version", "event_id", "sequence", "workspace_id", "timestamp", "actor", "type", "request_id", "request_hash", "session_id", "attempt_id", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "request_id": {"type": "string"},
    "request_hash": {"type": "string"},
    "session_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
