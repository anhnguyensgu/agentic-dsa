{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.algolearn/schemas/envelope-v2.json",
  "title": "Algorithm practice response envelope",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "status",
    "data",
    "events",
    "warnings",
    "error",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "pending",
        "error"
      ]
    },
    "data": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event-v2.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
