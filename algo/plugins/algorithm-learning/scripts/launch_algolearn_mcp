#!/bin/sh
# Starts the algo learning MCP server for Claude Code and Codex. The binary is
# ALGOLEARN_BIN, else the bundled bin/algo when it runs on this machine, else
# `algo` on PATH. The workspace is ALGOLEARN_WORKSPACE, else the directory the
# agent started the server in.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundled="$script_dir/../bin/algo"
binary=${ALGOLEARN_BIN:-}
if [ -z "$binary" ]; then
	# The bundled build targets one platform; elsewhere it fails to start.
	if [ -x "$bundled" ] && "$bundled" version >/dev/null 2>&1; then
		binary=$bundled
	elif command -v algo >/dev/null 2>&1; then
		binary=$(command -v algo)
	else
		echo "algorithm-learning: algo not found; run 'make install' in algo/ or set ALGOLEARN_BIN" >&2
		exit 127
	fi
fi
workspace=${ALGOLEARN_WORKSPACE:-"$PWD"}

exec "$binary" learn serve --workspace "$workspace"
