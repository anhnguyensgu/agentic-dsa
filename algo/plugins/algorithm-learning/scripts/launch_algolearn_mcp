#!/bin/sh
# Starts the algo learning MCP server for Claude Code and Codex. The binary is
# ALGOLEARN_BIN, else `algo` on PATH, else `make install`'s default location
# ~/.local/bin/algo, which an agent app started outside a shell may not have on
# PATH. The workspace is ALGOLEARN_WORKSPACE, else algo's global workspace
# (ALGO_WORKSPACE, else ~/algo).
set -eu

binary=${ALGOLEARN_BIN:-}
if [ -z "$binary" ]; then
	if command -v algo >/dev/null 2>&1; then
		binary=$(command -v algo)
	elif [ -x "${HOME:-}/.local/bin/algo" ]; then
		binary="$HOME/.local/bin/algo"
	else
		echo "algorithm-learning: algo not found; build it with 'make install' in algo/, or set ALGOLEARN_BIN" >&2
		exit 127
	fi
fi
if [ -n "${ALGOLEARN_WORKSPACE:-}" ]; then
	exec "$binary" learn serve --workspace "$ALGOLEARN_WORKSPACE"
fi
exec "$binary" learn serve
